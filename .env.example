# Copy to .env and edit. Lines are KEY=VALUE.

# Secret for marking songs and deleting comments. Pick something long.
ADMIN_KEY=change-me

# Folder to serve (top level only).
SONGS_DIR=D:\o

# PORT=3000
# HOST=0.0.0.0

# Set to 1 when running behind a tunnel or reverse proxy (cloudflared, ngrok,
# caddy, nginx) so rate limits use the real visitor IP from X-Forwarded-For.
# TRUST_PROXY=1
